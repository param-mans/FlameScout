DATA_MODE=fixture
# keyword | gemini (default: keyword)
EXTRACTOR=keyword
EXTRACT_TIMEOUT_S=4.0
GEMINI_API_KEY=
GEMINI_FAST_MODEL=
GEMINI_VISION_MODEL=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=flamescout
COSTAR_API_KEY=
# Real CoStar data: build once with `python scripts/build_costar_index.py <kit dir>`, then:
COSTAR_INDEX=data/costar/properties.jsonl
MATTERPORT_API_KEY=
VEXCEL_API_KEY=
# Postgres on Tiger Data: incidents, facts, segments, briefs, timings, agent threads (optional)
TIGER_DATABASE_URL=
# MongoDB Atlas: incident workspaces and prefetch cache (optional; unset = local files)
MONGODB_URI=
MONGODB_DB=flamescout
MAP_TOKEN=
# Optional live geocoder for the locator: nominatim (OpenStreetMap, 1 req/s)
GEOCODER=
CORS_ORIGINS=http://localhost:3000
