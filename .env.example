DATA_MODE=fixture
# keyword | gemini (default: keyword)
EXTRACTOR=keyword
EXTRACT_TIMEOUT_S=4.0
GEMINI_API_KEY=
GEMINI_FAST_MODEL=
GEMINI_VISION_MODEL=
# xAI Grok (optional; langchain-xai)
XAI_API_KEY=
XAI_FAST_MODEL=
XAI_VISION_MODEL=
# OpenAI (optional). OPENAI_BASE_URL points it at any OpenAI-compatible API.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=
OPENAI_VISION_MODEL=
# OPENAI_BASE_URL=
# gemini | openai | xai: main model; failover when a call on it fails; the model that critiques the brief
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=
CRITIC_PROVIDER=
# Wall-clock cap per orchestrator run, seconds; unset = 90 for brief v1, 75 for later versions
# RUN_DEADLINE_S=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=flamescout
COSTAR_API_KEY=
# Real CoStar data: build once with `python scripts/build_costar_index.py <kit dir>`, then:
COSTAR_INDEX=data/costar/properties.jsonl
MATTERPORT_API_KEY=
VEXCEL_API_KEY=
# Postgres on Tiger Data: incidents, facts, segments, briefs, timings, agent threads (optional)
TIGER_DATABASE_URL=
# MongoDB Atlas: incident workspaces and prefetch cache (optional; unset = local files)
MONGODB_URI=
MONGODB_DB=flamescout
MAP_TOKEN=
# Optional live geocoder for the locator: nominatim (OpenStreetMap, 1 req/s)
GEOCODER=
CORS_ORIGINS=http://localhost:3000

# Deploy (docs/deploy-vultr.md): Caddy site address, e.g. 45-77-1-2.sslip.io; unset = plain HTTP on :80
SITE_ADDRESS=
