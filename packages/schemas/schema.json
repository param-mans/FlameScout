{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "position": {
          "enum": [
            "center",
            "near_door",
            "near_window",
            "near_stairs",
            "north_side",
            "south_side",
            "east_side",
            "west_side"
          ],
          "title": "Position",
          "type": "string"
        },
        "ref_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Id"
        }
      },
      "required": [
        "room_id",
        "position"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Brief": {
      "properties": {
        "brief_id": {
          "title": "Brief Id",
          "type": "string"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "building_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Building Id"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "location_confirmed": {
          "title": "Location Confirmed",
          "type": "boolean"
        },
        "freshness": {
          "additionalProperties": true,
          "default": {},
          "title": "Freshness",
          "type": "object"
        },
        "size_up": {
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          },
          "default": {},
          "title": "Size Up",
          "type": "object"
        },
        "markers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Marker"
          },
          "title": "Markers",
          "type": "array"
        },
        "hazards": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Hazards",
          "type": "array"
        },
        "exposures": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Exposures",
          "type": "array"
        },
        "considerations": {
          "items": {
            "$ref": "#/$defs/Consideration"
          },
          "maxItems": 5,
          "title": "Considerations",
          "type": "array"
        },
        "changes_since_last": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Changes Since Last",
          "type": "array"
        },
        "gaps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        },
        "verifier_rejections": {
          "default": 0,
          "title": "Verifier Rejections",
          "type": "integer"
        },
        "evidence": {
          "additionalProperties": {
            "$ref": "#/$defs/Evidence"
          },
          "default": {},
          "title": "Evidence",
          "type": "object"
        },
        "crew_notes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CrewFeedback"
          },
          "title": "Crew Notes",
          "type": "array"
        },
        "published": {
          "default": false,
          "title": "Published",
          "type": "boolean"
        },
        "disclaimer": {
          "default": "Advisory only. Verify on arrival.",
          "title": "Disclaimer",
          "type": "string"
        }
      },
      "required": [
        "brief_id",
        "incident_id",
        "version",
        "location_confirmed"
      ],
      "title": "Brief",
      "type": "object"
    },
    "BuildingCandidate": {
      "description": "A building the dispatcher can confirm (PRD FR-3): the orchestrator's candidates.\n\nThe same fields as LocationCandidate (the rules pipeline's candidates), so the UI reads both the\nsame way. Filled deterministically by locator.find_candidates, never by an LLM.",
      "properties": {
        "building_id": {
          "title": "Building Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "coordinates": {
          "additionalProperties": true,
          "default": {},
          "title": "Coordinates",
          "type": "object"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "match_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Match Reasons",
          "type": "array"
        },
        "scan_available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Available"
        }
      },
      "required": [
        "building_id",
        "address",
        "score"
      ],
      "title": "BuildingCandidate",
      "type": "object"
    },
    "BuildingDossier": {
      "properties": {
        "building_id": {
          "title": "Building Id",
          "type": "string"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "coordinates": {
          "additionalProperties": true,
          "title": "Coordinates",
          "type": "object"
        },
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          },
          "default": {},
          "title": "Facts",
          "type": "object"
        },
        "tenants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Tenants",
          "type": "array"
        },
        "markers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Marker"
          },
          "title": "Markers",
          "type": "array"
        },
        "exposures": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Exposures",
          "type": "array"
        },
        "evidence": {
          "additionalProperties": {
            "$ref": "#/$defs/Evidence"
          },
          "default": {},
          "title": "Evidence",
          "type": "object"
        },
        "scan_available": {
          "default": false,
          "title": "Scan Available",
          "type": "boolean"
        },
        "scan_captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Captured At"
        },
        "matterport_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matterport Model Id"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "building_id",
        "address",
        "coordinates"
      ],
      "title": "BuildingDossier",
      "type": "object"
    },
    "Consideration": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "category": {
          "enum": [
            "access",
            "life_safety",
            "exposure",
            "hazard",
            "roof",
            "staging",
            "water_supply"
          ],
          "title": "Category",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "cross_layer": {
          "default": false,
          "title": "Cross Layer",
          "type": "boolean"
        },
        "refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rank",
        "category",
        "title",
        "rationale",
        "confidence"
      ],
      "title": "Consideration",
      "type": "object"
    },
    "Contradiction": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/ContradictionValue"
          },
          "title": "Values",
          "type": "array"
        },
        "resolved_by_dispatcher": {
          "default": false,
          "title": "Resolved By Dispatcher",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "values"
      ],
      "title": "Contradiction",
      "type": "object"
    },
    "ContradictionValue": {
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "value": {
          "title": "Value"
        },
        "span": {
          "additionalProperties": true,
          "title": "Span",
          "type": "object"
        }
      },
      "required": [
        "call_id",
        "value",
        "span"
      ],
      "title": "ContradictionValue",
      "type": "object"
    },
    "CopilotSuggestion": {
      "description": "L1 copilot: a question the dispatcher could ask next (FR-11).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "reason": {
          "default": "missing",
          "enum": [
            "missing",
            "contradiction"
          ],
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "dismissed",
            "asked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "incident_id",
        "field",
        "question"
      ],
      "title": "CopilotSuggestion",
      "type": "object"
    },
    "CrewFeedback": {
      "description": "Officer marks a fact correct / wrong / outdated (FR-15).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "building_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Building Id"
        },
        "fact_key": {
          "title": "Fact Key",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "correct",
            "wrong",
            "outdated"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "role": {
          "default": "officer",
          "title": "Role",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "incident_id",
        "fact_key",
        "verdict"
      ],
      "title": "CrewFeedback",
      "type": "object"
    },
    "Event": {
      "description": "Envelope for every WebSocket message on /ws/incidents/{id}.",
      "properties": {
        "type": {
          "enum": [
            "transcript.segment",
            "incident.updated",
            "contradiction.raised",
            "location.candidates",
            "dossier.progress",
            "brief.updated",
            "copilot.suggestion",
            "metric.tick",
            "overlay.updated"
          ],
          "title": "Type",
          "type": "string"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "payload": {
          "additionalProperties": true,
          "default": {},
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "type",
        "incident_id"
      ],
      "title": "Event",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "scan_frame",
            "scan_floorplan",
            "aerial_crop",
            "costar_record",
            "transcript_span",
            "rule_output",
            "crew_feedback"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "enum": [
            "matterport",
            "vexcel",
            "costar",
            "call",
            "rules",
            "crew"
          ],
          "title": "Source",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "captured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "locator": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        }
      },
      "required": [
        "id",
        "kind",
        "source"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Fact": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "value": {
          "title": "Value"
        },
        "status": {
          "enum": [
            "verified",
            "inferred",
            "reported",
            "unverified",
            "contradicted"
          ],
          "title": "Status",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "status",
        "confidence"
      ],
      "title": "Fact",
      "type": "object"
    },
    "IncidentOverlay": {
      "additionalProperties": false,
      "description": "One per brief version: overlay_vN.json, version == Brief.version.",
      "properties": {
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "changes_since_last": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Changes Since Last",
          "type": "array"
        },
        "occupants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverlayOccupant"
          },
          "title": "Occupants",
          "type": "array"
        },
        "fire": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverlayFire"
          },
          "title": "Fire",
          "type": "array"
        },
        "hazards": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverlayHazard"
          },
          "title": "Hazards",
          "type": "array"
        },
        "blocked": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverlayBlocked"
          },
          "title": "Blocked",
          "type": "array"
        },
        "contradictions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverlayContradiction"
          },
          "title": "Contradictions",
          "type": "array"
        },
        "objectives": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverlayObjective"
          },
          "title": "Objectives",
          "type": "array"
        },
        "considerations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverlayConsideration"
          },
          "title": "Considerations",
          "type": "array"
        },
        "routes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverlayRoute"
          },
          "title": "Routes",
          "type": "array"
        }
      },
      "required": [
        "incident_id",
        "model_id",
        "version",
        "as_of"
      ],
      "title": "IncidentOverlay",
      "type": "object"
    },
    "IncidentRecord": {
      "properties": {
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "status": {
          "default": "listening",
          "enum": [
            "listening",
            "locating",
            "confirmed",
            "briefing",
            "updated"
          ],
          "title": "Status",
          "type": "string"
        },
        "call_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Call Ids",
          "type": "array"
        },
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          },
          "default": {},
          "title": "Facts",
          "type": "object"
        },
        "evidence": {
          "additionalProperties": {
            "$ref": "#/$defs/Evidence"
          },
          "default": {},
          "title": "Evidence",
          "type": "object"
        },
        "contradictions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Contradiction"
          },
          "title": "Contradictions",
          "type": "array"
        },
        "open_questions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        },
        "confirmed_building_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed Building Id"
        },
        "ready_to_brief": {
          "default": false,
          "title": "Ready To Brief",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "incident_id"
      ],
      "title": "IncidentRecord",
      "type": "object"
    },
    "LocationCandidate": {
      "description": "A building the locator thinks the callers mean. Dispatcher must confirm one.",
      "properties": {
        "building_id": {
          "title": "Building Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "coordinates": {
          "additionalProperties": true,
          "default": {},
          "title": "Coordinates",
          "type": "object"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "match_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Match Reasons",
          "type": "array"
        },
        "scan_available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Available"
        }
      },
      "required": [
        "building_id",
        "address",
        "score"
      ],
      "title": "LocationCandidate",
      "type": "object"
    },
    "Marker": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "entry",
            "stair",
            "exit",
            "elevator",
            "key_box",
            "roof_access",
            "fdc",
            "standpipe",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "floor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor"
        },
        "scan_position": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Position"
        },
        "map_position": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map Position"
        },
        "status": {
          "enum": [
